#!/bin/sh

. "${0%/*}/env"

case "$(uname -s)/$(uname -m)" in
  Darwin/arm64)              MICROMAMBA_URL="https://github.com/mamba-org/micromamba-releases/releases/latest/download/micromamba-osx-arm64" ;;
  Linux/aarch64|Linux/arm64) MICROMAMBA_URL="https://github.com/mamba-org/micromamba-releases/releases/latest/download/micromamba-linux-aarch64" ;;
  Linux/x86_64|Linux/amd64)  MICROMAMBA_URL="https://github.com/mamba-org/micromamba-releases/releases/latest/download/micromamba-linux-64" ;;
  *) echo "Unsupported platform: $(uname -s)/$(uname -m)" >&2; exit 1 ;;
esac

curl -fLs "$MICROMAMBA_URL" -o "$MICROMAMBA_BIN"
chmod +x "$MICROMAMBA_BIN"

if [ "$(uname -s)" = "Darwin" ]
then
  xattr -dr com.apple.quarantine "$MICROMAMBA_BIN"
fi

"$MICROMAMBA_BIN" --version

mkdir -p "$MICROMAMBA_ENV"
"$MICROMAMBA_BIN" create -y -p "$MICROMAMBA_ENV" python=3.12
